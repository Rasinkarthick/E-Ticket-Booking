# Environment Variables for Vercel Deployment
# In Vercel, navigate to: Project Settings -> Environment Variables

# MongoDB Connection String (Required for cloud deployment)
# Get a free cloud database cluster from https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/eticket_db?retryWrites=true&w=majority

# JWT Secret Key for token generation & verification
JWT_SECRET=super_secret_eticket_jwt_key_2026_secured

# Optional configuration
PORT=5000
NODE_ENV=production
